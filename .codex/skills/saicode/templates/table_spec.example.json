{
  "table": "demo_feedback",
  "comment": "用户反馈表",
  "class": "CreateDemoFeedbackTable",
  "audit": true,
  "soft_delete": true,
  "fields": [
    {
      "name": "title",
      "type": "string",
      "limit": 120,
      "null": false,
      "default": "",
      "comment": "反馈标题"
    },
    {
      "name": "content",
      "type": "text",
      "null": false,
      "comment": "反馈内容"
    },
    {
      "name": "image",
      "type": "string",
      "limit": 1000,
      "null": true,
      "default": null,
      "comment": "反馈图片"
    },
    {
      "name": "status",
      "type": "tinyint",
      "null": false,
      "default": 1,
      "comment": "状态：1待处理 2已处理"
    },
    {
      "name": "sort",
      "type": "integer",
      "null": false,
      "default": 100,
      "comment": "排序"
    },
    {
      "name": "remark",
      "type": "string",
      "limit": 255,
      "null": true,
      "default": null,
      "comment": "备注"
    }
  ],
  "indexes": [
    {
      "columns": ["status"],
      "name": "idx_status"
    },
    {
      "columns": ["create_time"],
      "name": "idx_create_time"
    }
  ]
}
